  "pages": {
    "about": {
      "title": "About",
      "body": [
        "Ed Eastham is a contemporary artist working primarily in charcoal, chalk, acrylic, oils and mixed media, with a focus on portraiture and the figure. His work explores the human form and inner emotions of the subject. Specialising in portraiture and figurative life drawing, Ed captures the quiet, unseen narratives of human experience. Rather than aiming for simple replication, the works relies heavily on strong tonal values and dramatic lighting to sculpt a sense of mood and presence. By balancing light and shadow, Ed invites viewers into an intimate space, evoking powerful feelings and a connection with each subject. "
      ],
      "image": "work-01.jpg",
      "cv": []
    },
    "commission": {
      "title": "Commission",
      "body": [
        "Portraits and figurative works can be commissioned in charcoal, oil or mixed media, worked from your photographs or from sittings.",
        "Send a short note with what you have in mind, the size you would like and any photographs, and Ed will reply with timings and a price."
      ],
      "cta": "Enquire about a commission",
      "steps": [
        {
          "t": "Enquire",
          "d": "Email a short note with what you have in mind: who or what, the size you would like, and any photographs."
        },
        {
          "t": "Agree the piece",
          "d": "Ed replies with a medium, a size and a price. Charcoal, oil or mixed media, worked from your photographs or from sittings."
        },
        {
          "t": "Sittings and delivery",
          "d": "Progress photographs along the way, then the finished work delivered or collected, framed if you would like."
        }
      ]
    },
    "shop": {
      "title": "Shop",
      "body": [
        "Original works and prints. Available pieces will be listed here."
      ]
    },
    "contact": {
      "title": "Contact!",
      "body": [
        "For commissions, sales or anything else, email is best. Ed replies to everything."
